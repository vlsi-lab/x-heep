name: "pulp-platform.org:ip:obi_peripherals"

filesets:
  files_rtl:
    depend:
      - pulp-platform.org::common_cells
      - pulp-platform.org::relobi
      - x-heep::packages
    files:
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_pkg.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_register.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_modem.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_baudgen.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_rx.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_tx.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart_interrupts.sv
    - pulp_platform/obi_peripherals/hw/obi_uart/obi_uart.sv
    - pulp_platform/obi_peripherals/tmrg_files/syncTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/counterTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/delta_counterTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/fifo_v3TMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_baudgenTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_rxTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_txTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_modemTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_interruptsTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uart_registerTMR.sv
    - pulp_platform/obi_peripherals/tmrg_files/obi_uartTMR.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
    - files_rtl